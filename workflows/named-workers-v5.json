          {
            "comments": [],
            "desc": "Pinned chat. On a handover only its O code changes (O01 → O02). Plans the work from milestones.md, names and starts every worker, reviews each result, and keeps progress.md up to date. Tells you each new worker's exact name. After each review it checks its context room.",
            "effort": "high",
            "h": 160,
            "id": "co",
            "model": "gpt-6-astra",
            "name": "Current orchestrator · 00 - Orchestrator O01",
            "path": "",
            "provider": "codex",
            "rules": [
              {
                "if": [
                  "result passes review"
                ],
                "then": "accept the task"
              },
              {
                "if": [
                  "result fails review"
                ],
                "then": "send fix instructions to the SAME worker (name unchanged)"
              },
              {
                "if": [
                  "worker handed off mid-task"
                ],
                "then": "start fresh worker: same M, H+1; it reads the handoff doc first"
              },
              {
                "if": [
                  "result says compacted: replace me"
                ],
                "then": "after accepting, start a fresh worker for the next task: same M, H+1 (or M+1, H00 if the milestone is done)"
              },
              {
                "if": [
                  "milestone accepted"
                ],
                "then": "next worker is M+1, H00 - next name from milestones.md"
              },
              {
                "if": [
                  "a new worker is started"
                ],
                "then": "tell the user its exact name; log it in progress.md; archive the previous worker chat"
              },
              {
                "if": [
                  "you are not the OWNER in progress.md"
                ],
                "then": "send no tasks, start no workers, accept no results"
              }
            ],
            "tags": [
              "pinned"
            ],
            "type": "agent",
            "w": 240,
            "x": 0,
            "y": 0
          },
