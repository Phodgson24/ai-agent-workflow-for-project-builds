  "name": "user agent + project folder (sub-flow)",
  "nodes": [
    {
      "desc": "Plans the work and hands tasks to the worker slot. Reviews each result against the project, then accepts it or sends fix instructions. Starts a fresh worker from the handoff doc when the current one runs out of context.",
      "effort": "high",
      "h": 140,
      "id": "orch",
      "model": "gpt-6-astra",
      "name": "Orchestrator / Controller",
      "provider": "codex",
      "rules": [
        {
          "if": [
            "result passes review"
          ],
          "then": "accept and assign the next task"
        },
        {
          "if": [
            "result fails review"
          ],
          "then": "send fix instructions to the worker"
        }
      ],
      "type": "agent",
      "w": 240,
      "x": 0,
      "y": 160
    },
    {
